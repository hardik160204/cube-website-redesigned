# Copy to server/.env and fill in. Never commit the real .env.
NODE_ENV=production
PORT=5000
# The public address of the site (used in sitemap, canonical links, emails and unsubscribe links). No "www":
# www.cube-software.com redirects here (vercel.json). Other addresses of the same site are asked not to be indexed.
SITE_URL=https://cube-software.com
# Set when the site sits behind Nginx/IIS/Apache on another machine (default trusts a proxy on this machine).
# TRUST_PROXY=loopback

# Supabase (Project Settings > Data API / API Keys)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection: Supabase "Connect" > Transaction pooler URI (port 6543). Any other Postgres works too.
DATABASE_URL=postgresql://postgres.your-project:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Required in production: the database's CA certificate (Supabase: Project Settings > Database > SSL).
# Use DB_CA_FILE on a normal server, or DB_CA_CERT (the certificate's text) on hosts with no disk, e.g. Vercel.
DB_CA_FILE=/etc/cube/prod-supabase.cer
# DB_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Only on Vercel: the secret its cron sends to /api/cron/retention for the nightly clean-up.
# CRON_SECRET=
# Long random string, kept secret and stable. Encrypts admin authenticator secrets at rest and signs unsubscribe links
# (changing it makes links in emails already sent stop working).
APP_SECRET=change-me-to-a-long-random-string

# Outgoing mail (company mail server, Microsoft 365 or Google Workspace SMTP). Demo confirmations and newsletters go
# out as info@cube-software.com (changeable in the dashboard: Emails > Sender), so sign in as that mailbox, or as one
# allowed to send as it. Google Workspace: smtp.gmail.com, port 587, and an app password (Google Account > Security).
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@cube-software.com
SMTP_PASS=
# Sender of the team's own notifications (new demo requests, enquiries, unsubscribes).
MAIL_FROM="Cube Software <info@cube-software.com>"
# Who receives demo bookings and enquiries (comma separated). Can be changed later in the admin dashboard.
SALES_EMAILS=sales@cube-software.com

# Recommended on Vercel: one shared count for the limits against bots and floods (forms, sign-in). Free Upstash Redis
# (upstash.com, or Vercel > Storage > Redis, which sets KV_REST_API_URL and KV_REST_API_TOKEN for you).
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# Optional
# SESSION_HOURS=12
