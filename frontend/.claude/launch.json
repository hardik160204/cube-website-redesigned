{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "craco",
        "start"
      ],
      "env": {
        "BROWSER": "none",
        "PORT": "3001"
      },
      "port": 3001
    },
    {
      "name": "server",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--disable-warning=ExperimentalWarning",
        "--watch",
        "../server/src/index.js"
      ],
      "port": 5000
    }
  ]
}
